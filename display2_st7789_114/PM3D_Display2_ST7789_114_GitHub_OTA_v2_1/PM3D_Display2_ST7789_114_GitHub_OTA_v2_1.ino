  String train = mainRow.typeTrain.length() ? mainRow.typeTrain : String("TER 17524");

  String bottomMsg = transilienInfoText;
  bottomMsg.trim();
  if (bottomMsg == "Travaux a Villeneuve le Roi, l'arret est supprime. Bus de remplacement entre Ablon et Choisy le Roi. Plus d'informations: Transilien.com") bottomMsg = "En raison des conditions climatiques, certains trains sont supprimes";
  if (!bottomMsg.length()) bottomMsg = "En raison des conditions climatiques, certains trains sont supprimes";

  const int bottomTop = 116;
  const int leftW = 86;
  const int barX = 91;
  const int barW = 8;
  const int listX = 105;

  gfx->setTextWrap(false);
  gfx->setFont(NULL);
  gfx->fillRect(0, 0, 240, 135, blue);

  // Cadre blanc gauche.
  gfx->fillRect(0, 0, leftW, bottomTop, paper);
  gfx->drawFastVLine(leftW, 0, bottomTop, 0xC6FF);

  // Logo SNCF plus proche de la photo : petit cartouche magenta en haut gauche.
  gfx->fillRect(5, 7, 24, 12, sncfBg);
  gfx->fillTriangle(29, 7, 34, 7, 29, 19, sncfBg);
  gfx->setTextSize(1);
  gfx->setTextColor(C_WHITE, sncfBg);
  gfx->setCursor(sx(7), sy(10));
  gfx->print("SNCF");

  auto thickText1 = [&](int x, int y, uint16_t fg, uint16_t bg, const String &txt) {
    gfx->setTextSize(1);
    gfx->setTextColor(fg, bg);
    gfx->setCursor(sx(x), sy(y)); gfx->print(txt);
    gfx->setCursor(sx(x + 1), sy(y)); gfx->print(txt);
    gfx->setCursor(sx(x), sy(y + 1)); gfx->print(txt);
    gfx->setCursor(sx(x + 1), sy(y + 1)); gfx->print(txt);
  };
  auto detailTextBold = [&](int x, int y, uint16_t fg, uint16_t bg, const String &txt) {
    gfx->setFont(&FreeSansBold10pt7b);
    gfx->setTextSize(1);
    gfx->setTextColor(fg, bg);
    gfx->setCursor(sx(x), sy(y)); gfx->print(txt);
    gfx->setCursor(sx(x + 1), sy(y)); gfx->print(txt);
    gfx->setFont(NULL);
  };
  auto detailTextCompact = [&](int x, int y, uint16_t fg, uint16_t bg, const String &txt) {
    gfx->setFont(NULL);
    thickText1(x, y, fg, bg, txt);
  };
  auto detailTextMid = [&](int x, int y, uint16_t fg, uint16_t bg, const String &txt) {
    gfx->setFont(&FreeSansBold10pt7b);
    gfx->setTextSize(1);
    gfx->setTextColor(fg, bg);
    gfx->setCursor(sx(x), sy(y)); gfx->print(txt);
    gfx->setFont(NULL);
  };

  // Heure prevue et destination : police SNCF moyenne, lisible sans etre enorme.
  gfx->setFont(NULL);
  drawScaledGfxText(1, 34, ink, &FreeSansBold10pt7b, cutText(heure, 5), sncfDetailTimeScale);
  gfx->setTextColor(ink, paper);
  // Info personnalisable: petit bandeau limite a droite de l'heure prevue.
  // Si le texte est trop long, il defile de droite a gauche dans l'espace disponible.
  String statusView = status;
  statusView.trim();
  if (!statusView.length()) statusView = "à l'heure";
  // Info a cote de l'heure : defile en continu de droite a gauche si elle est trop longue.
  const int infoX = 55;
  const int infoY = 27;
  const int infoW = 28;
  const int infoH = 8;
  gfx->fillRect(infoX, infoY, infoW, infoH, paper);
  gfx->setTextSize(1);
  gfx->setTextColor(ink, paper);
  // Info reduite et contenue entre l'heure prevue et les points jaunes.
  // On affiche une fenetre de caracteres pour eviter tout debordement hors du cadre.
  int infoMaxChars = max(1, infoW / 6);
  String statusOut = statusView;
  if ((int)statusOut.length() > infoMaxChars) {
    String padded = statusView + "     ";
    int pos = (millis() / 320) % padded.length();
    statusOut = "";
    for (int k = 0; k < infoMaxChars; k++) statusOut += padded[(pos + k) % padded.length()];
  } else {
    statusOut = cutText(statusOut, infoMaxChars);
  }
  gfx->setCursor(sx(infoX + 1), sy(infoY + 1));
  gfx->print(statusOut);

  // "depart" anthracite clair : meme police que la destination, dessine verticalement.
  auto drawRotScaledGfxText = [&](int x, int y, uint16_t color, const GFXfont *font, const String &txt, int scalePct) {
    if (!font || scalePct <= 0) return;
    scalePct = constrain(scalePct, 1, 100);
    uint8_t first = pgm_read_byte(&font->first);
    uint8_t last = pgm_read_byte(&font->last);
    int16_t cursorY = 0;
    for (uint16_t n = 0; n < txt.length(); n++) {
      char c = txt[n];
      if (c < first || c > last) { cursorY += (7 * scalePct) / 100; continue; }
      GFXglyph *glyph = &(((GFXglyph *)pgm_read_pointer(&font->glyph))[c - first]);
      uint8_t *bitmap = (uint8_t *)pgm_read_pointer(&font->bitmap);
      uint16_t bo = pgm_read_word(&glyph->bitmapOffset);
      uint8_t w = pgm_read_byte(&glyph->width);
      uint8_t h = pgm_read_byte(&glyph->height);
      uint8_t xa = pgm_read_byte(&glyph->xAdvance);
      int8_t xo = (int8_t)pgm_read_byte(&glyph->xOffset);
      int8_t yo = (int8_t)pgm_read_byte(&glyph->yOffset);
      uint16_t bit = 0;
      for (uint8_t yy = 0; yy < h; yy++) {
        for (uint8_t xx = 0; xx < w; xx++, bit++) {
          uint8_t bits = pgm_read_byte(&bitmap[bo + (bit >> 3)]);
          if (bits & (0x80 >> (bit & 7))) {
            // rotation 90 degres anti-horaire : meme rendu FreeSansBold que destination.
            int px = x + ((yo + yy) * scalePct) / 100;
            int py = y - ((cursorY + xo + xx) * scalePct) / 100;
            gfx->drawPixel(sx(px), sy(py), color);
          }
        }
      }
      cursorY += (xa * scalePct) / 100;
    }
  };
  const uint16_t departAnthracite = 0xDEFB; // gris tres clair, depart discret sur le blanc
  drawRotScaledGfxText(78, 113, departAnthracite, &FreeSansBold10pt7b, "departs", 100);
  // Accent sur le e de departs (police GFX limitee ASCII, accent dessine a la main).
  gfx->drawLine(sx(72), sy(92), sx(75), sy(89), departAnthracite);
  gfx->drawLine(sx(73), sy(92), sx(76), sy(89), departAnthracite);

  // Destination personnalisable : si elle est trop longue, elle passe devant/surplombe
  // le mot departs au lieu d'etre coupee trop court.
  String destClean = dest;
  destClean.trim();
  if (!destClean.length()) destClean = "Bale";
  String destLine1 = destClean;
  String destLine2 = "";
  const int destMaxChars = 16; // ne passe a la ligne que si ca ne tient plus dans le cadre
  if ((int)destClean.length() > destMaxChars) {
    int cutAt = destClean.lastIndexOf(' ', destMaxChars);
    if (cutAt < 4) cutAt = destMaxChars;
    destLine1 = destClean.substring(0, cutAt);
    destLine2 = destClean.substring(cutAt);
    destLine1.trim();
    destLine2.trim();
  }
  bool destTwoLines = destLine2.length() > 0;
  gfx->setFont(NULL);
  gfx->setTextColor(ink, paper);
  int destGap = map(sncfDetailDestScale, 0, 100, 9, 17);
  drawScaledGfxText(1, 54, ink, &FreeSansBold10pt7b, cutText(destLine1, destMaxChars), sncfDetailDestScale);
  if (destTwoLines) {
    drawScaledGfxText(1, 54 + destGap, ink, &FreeSansBold10pt7b, cutText(destLine2, destMaxChars), sncfDetailDestScale);
  }

  // Type de train + numero personnalisables : plus petit et descend si la destination passe sur 2 lignes.
  String trainType = train;
  String trainNo = "";
  int sp = train.indexOf(' ');
  if (sp > 0) { trainType = train.substring(0, sp); trainNo = train.substring(sp + 1); }
  int trainY = destTwoLines ? 88 : 74; // le train descend si la destination prend 2 lignes
  gfx->setTextSize(1);
  gfx->setTextColor(inkLight, paper);
  gfx->setCursor(sx(6), sy(trainY)); gfx->print(cutText(trainType, 3));
  gfx->setCursor(sx(24), sy(trainY)); gfx->print(cutText(trainNo, 6));

  // Barre bleue legerement differente + pastilles jaunes.
  gfx->fillRect(barX, 0, barW, bottomTop, blueBar);
  gfx->drawFastVLine(barX + barW, 0, bottomTop, 0x145F);

  // Via personnalisables depuis l'interface : lignes 1 a 15.
  // Si plus de 8 via sont remplis, defilement vertical de bas en haut.
  String via[MAX_ROWS - 1];
  int viaCount = 0;
  const char *viaDef[8] = {"Mulhouse Ville", "Rixheim", "Habsheim", "Sierentz", "Bartenheim", "St Louis", "Bale St Jean", "Bale"};
  bool hasCustomVia = false;
  for (int idx = 1; idx < MAX_ROWS; idx++) {
    String vtxt = rows[idx].destination;
    vtxt.trim();
    if (vtxt.length()) hasCustomVia = true;
  }
  if (hasCustomVia) {
    for (int idx = 1; idx < MAX_ROWS; idx++) {
      String vtxt = rows[idx].destination;
      vtxt.trim();
      if (vtxt.length() && viaCount < (MAX_ROWS - 1)) via[viaCount++] = vtxt;
    }
  } else {
    for (int v = 0; v < 8 && viaCount < (MAX_ROWS - 1); v++) via[viaCount++] = String(viaDef[v]);
  }

  const int viaVisibleMax = 8;
  const int viaLineH = 12;
  int viaShown = min(viaVisibleMax, viaCount);
  int viaStart = 0;
  if (viaCount > viaVisibleMax) {
    unsigned long stepMs = 2000UL; // via SNCF detail : changement toutes les 2 secondes
    viaStart = (millis() / stepMs) % viaCount;
  }
  int viaTop = 13;
  gfx->setTextSize(1);
  gfx->setTextColor(C_WHITE, blue);
  for (int slot = 0; slot < viaShown; slot++) {
    int src = (viaStart + slot) % viaCount;
    int y = viaTop + slot * viaLineH;
    gfx->fillCircle(barX + 4, y + 3, 3, dot);
    gfx->setTextSize(1);
    gfx->setTextColor(C_WHITE, blue);
    String txt = cutText(via[src], 18);
    gfx->setCursor(sx(listX), sy(y)); gfx->print(txt);
    gfx->setCursor(sx(listX + 1), sy(y)); gfx->print(txt);
    gfx->setCursor(sx(listX), sy(y + 1)); gfx->print(txt);
  }

  // Bandeau bas bleu defilant de droite a gauche, arrete avant l'heure actuelle.
  gfx->fillRect(0, bottomTop, 187, 19, blue);
  gfx->drawFastHLine(0, bottomTop, 187, 0x5DFF);
  String scrollMsg = bottomMsg + "        ";
  // Defilement fenetre : le texte entier passe dans la barre, sans etre coupe par l'horloge.
  fixedSmallText(4, 123, C_WHITE, marqueeWindow(scrollMsg, 30, 90));

  // Heure actuelle en bas a droite : rectangle agrandi, decale de 2 px du bord droit, texte plus espace.
  gfx->fillRect(187, bottomTop, 53, 19, blue);
  // Cadre heure plus bas et moins haut.
  gfx->fillRect(188, 118, 50, 15, blueDark);
  gfx->drawFastHLine(188, 118, 50, C_WHITE);      // haut
  gfx->drawFastVLine(188, 118, 15, C_WHITE);      // gauche
  gfx->drawFastVLine(237, 118, 15, C_WHITE);      // droite
  String now = pm3dDynamicClockSeconds();
  String hh = now.length() >= 5 ? now.substring(0, 2) : String("06");
  String mm = now.length() >= 5 ? now.substring(3, 5) : String("58");
  String ss = now.length() >= 8 ? now.substring(6, 8) : String("52");
  gfx->setTextSize(1);
  gfx->setTextColor(C_WHITE, blueDark);
  // Horloge alignee et un peu rapprochee : h / m / s sur la meme base.
  gfx->setCursor(sx(193), sy(122)); gfx->print(hh);
  gfx->setCursor(sx(208), sy(122)); gfx->print(mm);
  gfx->setTextColor(orangeSec, blueDark);
  gfx->setCursor(sx(223), sy(122)); gfx->print(ss);
}

void drawSncfValenceSideDynamicOnly() {
  // Mise a jour sans redessiner tout l'ecran : evite le scintillement.
  const uint16_t blue      = 0x02B8;
  const uint16_t blueDark  = 0x0155;
  const uint16_t paper     = 0xF7BF;
  const uint16_t ink       = blue;
  const uint16_t orangeSec = 0xFD20;
  Row &mainRow = rows[visibleRowIndex(scrollOffset)];
  String status = mainRow.info.length() ? mainRow.info : String("à l'heure");
  if (status.startsWith("Via ") || status.startsWith("via ") || status.indexOf(" - ") >= 0) status = "à l'heure";
  status.trim();
  if (!status.length()) status = "à l'heure";
  String bottomMsg = transilienInfoText;
  bottomMsg.trim();
  if (bottomMsg == "Travaux a Villeneuve le Roi, l'arret est supprime. Bus de remplacement entre Ablon et Choisy le Roi. Plus d'informations: Transilien.com") bottomMsg = "En raison des conditions climatiques, certains trains sont supprimes";
  if (!bottomMsg.length()) bottomMsg = "En raison des conditions climatiques, certains trains sont supprimes";

  const int bottomTop = 116;
  const int leftW = 86;
  const int infoX = 55;
  const int infoY = 27;
  const int infoW = 28;
  const int infoH = 8;

  gfx->setTextWrap(false);
  gfx->setFont(NULL);

  // Info a cote de l'heure prevue : efface uniquement sa petite zone.
  gfx->fillRect(infoX, infoY, infoW, infoH, paper);
  gfx->setTextSize(1);
  gfx->setTextColor(ink, paper);
  // Info reduite et contenue entre l'heure prevue et les points jaunes.
  int infoMaxChars = max(1, infoW / 6);
  String statusOut = status;
  if ((int)statusOut.length() > infoMaxChars) {
    String padded = status + "     ";
    int pos = (millis() / 320) % padded.length();
    statusOut = "";
    for (int k = 0; k < infoMaxChars; k++) statusOut += padded[(pos + k) % padded.length()];
  } else {
    statusOut = cutText(statusOut, infoMaxChars);
  }
  gfx->setCursor(sx(infoX + 1), sy(infoY + 1));
  gfx->print(statusOut);
  // VIA anti-scintillement : la zone est dessinee uniquement dans drawSncfValenceSideRows().
  // On ne la redessine plus dans la mise a jour dynamique (horloge / bandeau / info),
  // sinon elle scintille a chaque rafraichissement.

  // Bandeau bas defilant, sans recouvrir l'horloge.
  gfx->fillRect(0, bottomTop, 187, 19, blue);
  gfx->drawFastHLine(0, bottomTop, 187, 0x5DFF);
  String scrollMsg = "     " + bottomMsg + "     ";
  int msgW = scrollMsg.length() * 6;
  int bandW = 184;
  int bx = bandW - ((millis() / 45) % (msgW + bandW));
  fixedSmallText(bx, 123, C_WHITE, scrollMsg);
  if (bx + msgW < bandW) fixedSmallText(bx + msgW + 12, 123, C_WHITE, scrollMsg);

  // Horloge h/m/s en temps reel.
  gfx->fillRect(187, bottomTop, 53, 19, blue);
  gfx->fillRect(188, 118, 50, 15, blueDark);
  gfx->drawFastHLine(188, 118, 50, C_WHITE);
  gfx->drawFastVLine(188, 118, 15, C_WHITE);
  gfx->drawFastVLine(237, 118, 15, C_WHITE);
  String now = pm3dDynamicClockSeconds();
  String hh = now.substring(0, 2);
  String mm = now.substring(3, 5);
  String ss = now.substring(6, 8);
  gfx->setTextSize(1);
  gfx->setTextColor(C_WHITE, blueDark);
  gfx->setCursor(sx(193), sy(122)); gfx->print(hh);
  gfx->setCursor(sx(208), sy(122)); gfx->print(mm);
  gfx->setTextColor(orangeSec, blueDark);
  gfx->setCursor(sx(223), sy(122)); gfx->print(ss);
}

