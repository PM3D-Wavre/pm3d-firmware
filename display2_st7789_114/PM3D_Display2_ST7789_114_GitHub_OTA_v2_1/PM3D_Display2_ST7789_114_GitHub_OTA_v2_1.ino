    json += "\"h\":\"" + jsonEscape(rows[idx].heure) + "\",";
    json += "\"d\":\"" + jsonEscape(rows[idx].destination) + "\",";
    json += "\"t\":\"" + jsonEscape(rows[idx].typeTrain) + "\",";
