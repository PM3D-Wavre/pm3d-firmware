int dbClockMinutes() {
  int minutes = 0;
  if (syncedClockMinutes(minutes)) return minutes;
  return (dbIntercityClockHour * 60 + dbIntercityClockMinute + (int)(millis() / 60000UL)) % 1440;
}

String dbClockText() {
  return formatDisplayTime(dbClockMinutes(), ':');
}

