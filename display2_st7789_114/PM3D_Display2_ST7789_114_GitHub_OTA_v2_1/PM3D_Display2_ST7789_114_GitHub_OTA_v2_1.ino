}String pm3dDynamicClock() {
  int syncedMinutes = 0;
  if (syncedClockMinutes(syncedMinutes)) return formatDisplayTime(syncedMinutes, ':');
  int hh = ((__TIME__[0] - '0') * 10) + (__TIME__[1] - '0');
  int mm = ((__TIME__[3] - '0') * 10) + (__TIME__[4] - '0');
  int ss = ((__TIME__[6] - '0') * 10) + (__TIME__[7] - '0');
  unsigned long total = (unsigned long)hh * 3600UL + (unsigned long)mm * 60UL + (unsigned long)ss + millis() / 1000UL;
  total %= 86400UL;
  hh = total / 3600UL;
  mm = (total % 3600UL) / 60UL;
  char buf[6];
  snprintf(buf, sizeof(buf), "%02d:%02d", hh, mm);
  return String(buf);
}

String pm3dDynamicClockSeconds() {
  int syncedMinutes = 0;
  int hh, mm, ss;
  if (syncedClockMinutes(syncedMinutes)) {
    unsigned long total = (unsigned long)(syncedMinutes % 1440) * 60UL + (millis() / 1000UL) % 60UL;
    total %= 86400UL;
    hh = total / 3600UL;
    mm = (total % 3600UL) / 60UL;
    ss = total % 60UL;
  } else {
    hh = ((__TIME__[0] - '0') * 10) + (__TIME__[1] - '0');
    mm = ((__TIME__[3] - '0') * 10) + (__TIME__[4] - '0');
    ss = ((__TIME__[6] - '0') * 10) + (__TIME__[7] - '0');
    unsigned long total = (unsigned long)hh * 3600UL + (unsigned long)mm * 60UL + (unsigned long)ss + millis() / 1000UL;
    total %= 86400UL;
    hh = total / 3600UL;
    mm = (total % 3600UL) / 60UL;
    ss = total % 60UL;
  }
  char buf[9];
  snprintf(buf, sizeof(buf), "%02d:%02d:%02d", hh, mm, ss);
  return String(buf);
}

