void drawSncfIdfCrtRows() {
  // SNCF / Transilien CRT bleu - uniquement pour le profil CRT.
  // Reglage police : utilise le reglage global "Police" mais limite a 1.0..1.8
  // pour permettre de grossir un peu sans revenir a une police enorme.
  const uint16_t bg     = 0x03BF;   // bleu clair CRT visible sur ST7789
  const uint16_t bgScan = 0x049F;   // leger balayage bleu
  const uint16_t yellow = 0xFFE0;   // jaune CRT
  const uint16_t white  = C_WHITE;

  gfx->setTextWrap(false);
  gfx->setFont(NULL);
  gfx->setTextSize(1);

  // Fond complet : pas de noir sauf le cartouche horloge.
  gfx->fillScreen(bg);

  // Leger effet lignes CRT, tres discret.
  for (int y = 0; y < 135; y += 6) {
    gfx->drawFastHLine(0, y, 240, bgScan);
  }

  // Colonnes comme la photo de reference.
  const int xName  = 8;
  const int xLine1 = 55;
  const int xDest  = 66;
  const int xLine2 = 156;
  const int xHour  = 166;
  const int xLine3 = 215;
  const int xVoie  = 224;

  const int headerY = 12;
  const int lineTop = 6;
  const int sepY = 28;
  const int lineBottom = 132;
  const int rowTop = 34;
  const int rowH = 15;
  const int rowsToDraw = 6;

  // Entete jaune.
  gfx->setTextSize(1);
  gfx->setTextColor(yellow, bg);
  gfx->setCursor(sx(xName), sy(headerY)); gfx->print("Nom");
  gfx->setCursor(sx(xDest), sy(headerY)); gfx->print("Destination");
  gfx->setCursor(sx(xHour), sy(headerY)); gfx->print("Heure");

  // Separateurs jaunes.
  // Les 2 premieres lignes montent dans l'entete.
  gfx->fillRect(xLine1 - 1, lineTop, 3, lineBottom - lineTop, yellow);
  gfx->fillRect(xLine2 - 1, lineTop, 3, lineBottom - lineTop, yellow);
  // Ligne de droite : on supprime uniquement la partie au-dessus de la ligne horizontale.
  gfx->fillRect(xLine3 - 1, sepY + 1, 3, lineBottom - (sepY + 1), yellow);
  gfx->fillRect(4, sepY - 1, 232, 3, yellow);

  // Horloge en haut a droite : texte jaune sur fond noir, sans cadre jaune.
  // Rectangle reduit pour entourer seulement l'heure.
  const int clockX = 201;
  const int clockY = 7;
  const int clockW = 34;
  const int clockH = 14;
  gfx->fillRect(clockX, clockY, clockW, clockH, C_BLACK);
  gfx->setTextColor(yellow, C_BLACK);
  gfx->setCursor(sx(clockX + 2), sy(clockY + 3));
  gfx->print(pm3dDynamicClock().substring(0, 5));

  // Texte blanc fin : reglage via "Police" de l'interface.
  // Niveau 1 = fin, niveaux 2..4 = un peu plus epais, sans doubler la hauteur.
  int crtFontLevel = constrain(tunedFontSize(), 1, 4);

  for (int i = 0; i < rowsToDraw; i++) {
    int idx = visibleRowIndex(scrollOffset + i);
    int y = rowTop + i * rowH;

    String nom = rows[idx].typeTrain.length() ? rows[idx].typeTrain : String((i & 1) ? "PUMA" : "CILE");
    nom.toUpperCase();

    String dest = rows[idx].destination.length() ? rows[idx].destination : String((i & 1) ? "Paris Est" : "Chelles Gournay");
    dest.toUpperCase();
    if (dest == "PARIS EST") dest = "PARIS E.";
    if (dest == "CHELLES GOURNAY") dest = "CHELLES";

    String heure = rows[idx].heure.length() ? rows[idx].heure : String((i & 1) ? "17.32" : "17.28");
    heure.replace(':', '.');

    String voie = rows[idx].voie.length() ? rows[idx].voie : String((i & 1) ? "E" : "B");
    voie.toUpperCase();

    fineTextAt(xName, y, white, cutText(nom, 6), crtFontLevel);
    fineTextAt(xDest, y, white, cutText(dest, 14), crtFontLevel);
    fineTextAt(xHour, y, white, cutText(heure, 5), crtFontLevel);
    fineTextAt(xVoie, y, white, cutText(voie, 1), crtFontLevel);
  }

  gfx->setTextSize(1);
}


void drawFlipCellsText(int x, int y, int cells, const String &txt) {
  const uint16_t cellBg = 0x2104;
  const uint16_t edge = 0x4208;
  const uint16_t yellow = 0xFEE0;
  String s = txt;
  s.toUpperCase();
  for (int i = 0; i < cells; i++) {
    int cx = x + i * 9;
    gfx->fillRect(cx, y, 8, 10, cellBg);
    gfx->drawRect(cx, y, 8, 10, edge);
    gfx->drawFastHLine(cx + 1, y + 5, 6, edge);
    char ch = i < (int)s.length() ? s[i] : ' ';
    if (ch != ' ') {
      gfx->setTextSize(1);
      gfx->setTextColor(yellow, cellBg);
      gfx->setCursor(sx(cx + 1), sy(y + 1));
      gfx->print(ch);
    }
  }
}

void drawSncfDepartGrandesLignesRows() {
  // SNCF Depart Grandes Lignes - profil SNCF Depart uniquement.
  // V15 : via horizontal ralenti, point jaune inclus dans le defilement.
  const uint16_t pageBg = 0x20E7;
  const uint16_t blueA  = 0x2ABF;
  const uint16_t blueB  = 0x21F3;
  const uint16_t sideTxt = 0x7DFF;  // bleu ciel pour le mot departs
  const uint16_t white  = C_WHITE;
  const uint16_t yellow = C_YELLOW;

  struct SncfDepartRow {
    const char *logo;
    const char *numero;
    const char *heure;
    const char *destination;
    const char *voie;
    const char *via;
  };

  const SncfDepartRow data[] = {
    {"TER", "893021", "08h02", "Toulouse",             "9", "Agen  -  Nimes  -  Montpellier St-Roch  -  Narbonne"},
    {"TGV", "5311",   "08h07", "Paris Gare de Lyon",   "7", "Le Creusot TGV  -  Dijon Ville  -  Paris Gare de Lyon"},
    {"TGV", "23590",  "08h09", "Rennes",               "5", "Massy TGV  -  Le Mans  -  Laval"},
    {"IC",  "45821",  "08h17", "Montereau",            "3", "Melun  -  Fontainebleau Avon"},
    {"TER", "876399", "08h22", "Bordeaux St-Jean",     "6", "Libourne  -  Angouleme  -  Poitiers"},
    {"TGV", "2778",   "08h30", "Paris-Est",            "8", "Dijon Ville  -  Troyes  -  Paris Est"},
    {"TGV", "6178",   "08h51", "Nice-Ville",           "4", "Avignon TGV  -  Aix TGV  -  Toulon"},
    {"TGV", "6809",   "09h24", "Marseille St-Charles", "2", "Avignon TGV  -  Aix-en-Provence TGV"}
  };
  const int count = sizeof(data) / sizeof(data[0]);

  auto rowText = [&](int idx, char field)->String {
    int r = idx % count;
    if (r < 0) r += count;
    if (r < MAX_ROWS) {
      if (field == 't' && rows[r].typeTrain.length()) return rows[r].typeTrain;
      if (field == 'n' && rows[r].retard.length()) return rows[r].retard; // utilise Retard comme numero train si rempli
      if (field == 'h' && rows[r].heure.length()) return rows[r].heure;
      if (field == 'd' && rows[r].destination.length()) return rows[r].destination;
      if (field == 'v' && rows[r].voie.length()) return rows[r].voie;
      if (field == 'i' && rows[r].info.length()) return rows[r].info;
    }
    if (field == 't') return String(data[r].logo);
    if (field == 'n') return String(data[r].numero);
    if (field == 'h') return String(data[r].heure);
    if (field == 'd') return String(data[r].destination);
    if (field == 'v') return String(data[r].voie);
    if (field == 'i') return String(data[r].via);
    return String("");
  };

  gfx->setTextWrap(false);
  gfx->setFont(NULL);

  // Fond fixe complet : uniquement au dessin complet, pas a chaque tick d'animation.
  if (!rowsOnlyPass) {
    gfx->fillRect(0, 0, 240, 135, pageBg);

    // Titre haut gauche petit, comme l'ecran reel.
    gfx->setTextSize(1);
    gfx->setTextColor(white, pageBg);
    gfx->setCursor(sx(4), sy(4));
    gfx->print("Departs");
  }

  // Geometrie du tableau.
  const int tableX = 2;
  const int tableY = 18;
  const int tableW = 236;
  const int firstH = 25;
  const int rowH   = 13;
  const int smallRows = 6;
  const int footerY = 122;
  const int tableH = firstH + smallRows * rowH;

  const int xLogo  = 4;
  const int xNum   = 31;
  const int xHour  = 66;
  const int xDest  = 100;
  const int xDestW = 96;
  const int xVoie  = 202;
  const int sideX  = 221;

  const uint32_t cycleMs = 3600UL;
  uint32_t now = millis();
  int base = (now / cycleMs) % count;
  static int renderedBase = -1;
  const uint32_t viaCycleMs = 7000UL;
  auto drawViaMarquee = [&](const String &rawVia, int y, uint16_t bg) {
    String via = rawVia;
    if (via.length() == 0) via = "Direct";
    String text = "  " + via + "     ";
    const int charW = 6;
    const int textX = xDest + 10;
    const int textW = xDestW - 10;
    const int maxChars = max(1, textW / charW);
    const int totalChars = max(maxChars + 1, (int)text.length());
    int offset = (int)(((now % viaCycleMs) * totalChars) / viaCycleMs);
    String doubled = text + text;
    if (offset >= (int)text.length()) offset %= text.length();
    String out = doubled.substring(offset, offset + maxChars);

    gfx->fillRect(sx(xDest), sy(y), xDestW, 10, bg);
    int dotX = textX - offset * charW;
    while (dotX < xDest - 3) dotX += text.length() * charW;
    while (dotX < xDest + xDestW) {
      if (dotX >= xDest && dotX <= xDest + xDestW - 4) gfx->fillCircle(sx(dotX), sy(y + 5), 2, yellow);
      dotX += text.length() * charW;
    }
    gfx->setTextSize(1);
    gfx->setTextColor(white, bg);
    gfx->setCursor(sx(textX), sy(y + 1));
    gfx->print(out);
  };

  // Tick leger : entre deux changements de train, on ne redessine que le via de la premiere ligne.
  if (rowsOnlyPass && renderedBase == base) {
    uint16_t bg0 = blueA;
    drawViaMarquee(rowText(base, 'i'), tableY + 14, bg0);
    return;
  }
  renderedBase = base;

  // Bandes fixes : redessinees seulement quand la page change ou au dessin complet.
  gfx->fillRect(tableX, tableY, tableW, tableH, blueB);
  gfx->fillRect(tableX, tableY, tableW, firstH - 1, blueA);
  for (int i = 0; i < smallRows; i++) {
    int y = tableY + firstH + i * rowH;
    gfx->fillRect(tableX, y, tableW, rowH - 1, (i & 1) ? blueA : blueB);
  }

  auto drawLogo = [&](const char *logo, int x, int y, uint16_t bg) {
    if (y < tableY - 10 || y > tableY + tableH) return;
    gfx->setTextSize(1);
    String lg = String(logo);
    if (lg == "SNCF") {
      gfx->fillRect(sx(x), sy(y), 22, 9, C_WHITE);
      gfx->setTextColor(0x03A0, C_WHITE);
      gfx->setCursor(sx(x + 1), sy(y + 1)); gfx->print("SNCF");
    } else if (lg == "TER") {
      // TER sans fond vert : texte blanc discret sur la ligne bleue.
      gfx->setTextColor(white, bg);
      gfx->setCursor(sx(x + 1), sy(y + 1)); gfx->print("ter");
    } else if (lg == "TGV") {
      gfx->setTextColor(white, bg);
      gfx->setCursor(sx(x + 1), sy(y + 1)); gfx->print("TGV");
    } else {
      gfx->fillRect(sx(x), sy(y), 18, 9, yellow);
      gfx->setTextColor(C_BLACK, yellow);
      gfx->setCursor(sx(x + 3), sy(y + 1)); gfx->print("IC");
    }
  };

  auto fitCell = [&](int x, int y, int w, int h, int wantedSize, uint16_t fg, uint16_t bg, const String &txt, bool scroll, int speed) {
    if (y + h < tableY || y > tableY + tableH) return;
    int yy = max(y, tableY);
    int hh = h - max(0, tableY - y);
    if (yy + hh > tableY + tableH) hh = tableY + tableH - yy;
    if (hh <= 0) return;
    int size = wantedSize;
    while (size > 1 && ((int)txt.length() * 6 * size) > (w - 2)) size--;
    int charW = max(1, 6 * size);
    int maxChars = max(1, (w - 2) / charW);
    String out = txt;
    if ((int)out.length() > maxChars) out = scroll ? marqueeSlice(out, maxChars, speed) : cutText(out, maxChars);
    gfx->fillRect(sx(x), sy(yy), w, hh, bg);
    gfx->setTextSize(size);
    gfx->setTextColor(fg, bg);
    gfx->setCursor(sx(x + 1), sy(y + max(0, (h - 8 * size) / 2)));
    gfx->print(out);
  };

  // Changement propre par ligne complete : pas de traces pendant la montee.
  int scrollPx = 0;

  auto drawActiveRow = [&](int rowIdx, int y0, uint16_t bg0) {
    drawLogo(rowText(rowIdx, 't').c_str(), xLogo, y0 + 4, bg0);
    fitCell(xNum,  y0 + 1, 32, 11, 1, white,  bg0, rowText(rowIdx, 'n'), false, 200);
    fitCell(xHour, y0 + 1, 32, 11, 1, yellow, bg0, rowText(rowIdx, 'h'), false, 200);
    // Destination modifiable depuis l'interface.
    fitCell(xDest, y0 + 1, xDestW, 11, 1, white, bg0, rowText(rowIdx, 'd'), false, 230);

    if (y0 + 14 >= tableY && y0 + 24 <= tableY + tableH) {
      drawViaMarquee(rowText(rowIdx, 'i'), y0 + 14, bg0);
    }

    // La voie ne s'affiche que pour la ligne du haut active.
    String voieTxt = rowText(rowIdx, 'v');
    if (voieTxt.length() && y0 >= tableY - 3 && y0 < tableY + firstH) {
      gfx->fillRoundRect(sx(xVoie), sy(y0 + 4), 15, 17, 2, blueB);
      gfx->drawRoundRect(sx(xVoie), sy(y0 + 4), 15, 17, 2, white);
      fitCell(xVoie + 2, y0 + 6, 11, 12, 2, white, blueB, voieTxt, false, 200);
    }
  };

  auto drawSmallRow = [&](int rowIdx, int line, int y) {
    uint16_t bg = (line & 1) ? blueA : blueB;
    drawLogo(rowText(rowIdx, 't').c_str(), xLogo, y + 3, bg);
    fitCell(xNum,  y + 2, 32, 10, 1, white,  bg, rowText(rowIdx, 'n'), false, 200);
    fitCell(xHour, y + 2, 32, 10, 1, yellow, bg, rowText(rowIdx, 'h'), false, 200);
    fitCell(xDest, y + 1, xDestW, 12, 1, white, bg, rowText(rowIdx, 'd'), false, 260 + line * 50);
  };

  // Redessine les infos en mouvement sur le fond fixe.
  drawActiveRow(base, tableY - scrollPx, blueA);
  for (int line = 0; line < smallRows + 1; line++) {
    int idx = (base + 1 + line) % count;
    int y = tableY + firstH + line * rowH - scrollPx;
    drawSmallRow(idx, line, y);
  }

  // Legendes basses fixes : uniquement au dessin complet.
  if (!rowsOnlyPass) {
    gfx->fillRect(0, footerY, 240, 13, pageBg);
    gfx->setTextSize(1);
    gfx->setTextColor(white, pageBg);
    gfx->setCursor(sx(4),   sy(124)); gfx->print("train");
    gfx->setCursor(sx(32),  sy(124)); gfx->print("no");
    gfx->setCursor(sx(67),  sy(124)); gfx->print("heure");
    gfx->setCursor(sx(101), sy(124)); gfx->print("destination");
    gfx->setCursor(sx(207), sy(124)); gfx->print("voie");
    gfx->fillRect(sx(194), sy(122), 43, 12, 0x0012);
    gfx->drawRect(sx(194), sy(122), 43, 12, 0x4A9F);
    String clock = pm3dDynamicClock().substring(0, 5);
    clock.replace(':', ' ');
    gfx->setCursor(sx(199), sy(125)); gfx->print(clock);
  }

  // Mot "dÃ©part" dessine EN DERNIER : il passe au-dessus des lignes et n'est plus cache.
  auto patFor = [](char c)->const char* const* {
    static const char* d[] = {"00000","11110","10001","10001","10001","10001","11110"};
    static const char* e[] = {"00000","01110","10001","11111","10000","10001","01110"};
    static const char* p[] = {"00000","11110","10001","10001","11110","10000","10000"};
    static const char* a[] = {"00000","01110","00001","01111","10001","10011","01101"};
    static const char* r[] = {"00000","10110","11001","10000","10000","10000","10000"};
    static const char* i[] = {"00100","00000","01100","00100","00100","00100","01110"};
    static const char* v[] = {"00000","10001","10001","10001","10001","01010","00100"};
    static const char* t[] = {"00100","00100","11111","00100","00100","00101","00010"};
    static const char* s[] = {"00000","01111","10000","01110","00001","10001","01110"};
    switch (c) { case 'd': return d; case 'e': return e; case 'p': return p; case 'a': return a; case 'r': return r; case 'i': return i; case 'v': return v; case 's': return s; default: return t; }
  };
  auto drawRotChar = [&](char c, int x, int y, int sc, uint16_t col) {
    const char* const* p = patFor(c);
    for (int yy = 0; yy < 7; yy++) {
      for (int xx = 0; xx < 5; xx++) {
        if (p[yy][xx] == '1') {
          gfx->fillRect(sx(x + yy * sc), sy(y + (4 - xx) * sc), sc, sc, col);
        }
      }
    }
  };

  const char *sideWord = "departs";  // affichage visuel : departs + accent sur le e
  const int sideScale = 2;
  const int sideStep = 13;
  int sideY = 103 + styleSideY;     // cale sur les 7 lignes visibles, reglable par style.
  for (int i = 0; sideWord[i]; i++) drawRotChar(sideWord[i], sideX, sideY - i * sideStep, sideScale, sideTxt);
  // Accent du Ã© de dÃ©part.
  int eY = sideY - sideStep;
  gfx->drawLine(sx(sideX + 3), sy(eY - 5), sx(sideX + 9), sy(eY - 9), sideTxt);
  gfx->drawLine(sx(sideX + 4), sy(eY - 5), sx(sideX + 10), sy(eY - 9), sideTxt);
}

void drawSncfArriveesGrandesLignesRows() {
  // SNCF Arrivees Grandes Lignes - copie verte du profil SNCF Depart.
  // V1 : copie du SNCF Depart en palette arrivees verte.
  const uint16_t pageBg = 0x0108;
  const uint16_t blueA  = 0x0C67;
  const uint16_t blueB  = 0x0345;
  const uint16_t sideTxt = 0x0EAA;
  const uint16_t white  = C_WHITE;
  const uint16_t yellow = C_YELLOW;

  struct SncfDepartRow {
    const char *logo;
    const char *numero;
    const char *heure;
    const char *destination;
    const char *voie;
    const char *via;
  };

  const SncfDepartRow data[] = {
    {"SNCF", "865421", "14h29", "Paris Montparnasse", "A", "Chartres  -  Versailles Chantiers"},
    {"SNCF", "38412",  "15h18", "Saintes",             "4", "Rochefort  -  La Rochelle Ville"},
    {"SNCF", "83726",  "15h23", "La Rochelle Ville",  "A", "Niort  -  SurgÃ¨res"},
    {"SNCF", "86408",  "16h12", "Fontenay Le Comte", "",  "LuÃ§on  -  La Roche-sur-Yon"},
    {"SNCF", "83744",  "16h38", "Poitiers",           "B", "Niort  -  Saint-Maixent"},
    {"SNCF", "83752",  "16h46", "La Rochelle Ville",  "A", "Rochefort  -  SurgÃ¨res"},
    {"SNCF", "86422",  "17h09", "Fontenay Le Comte", "",  "LuÃ§on  -  La Roche-sur-Yon"},
    {"SNCF", "865438", "17h31", "Bordeaux St-Jean",   "3", "AngoulÃªme  -  Saintes  -  Rochefort"}
  };
  const int count = sizeof(data) / sizeof(data[0]);

  auto rowText = [&](int idx, char field)->String {
    int r = idx % count;
    if (r < 0) r += count;
    if (r < MAX_ROWS) {
      if (field == 't' && rows[r].typeTrain.length()) return rows[r].typeTrain;
      if (field == 'n' && rows[r].retard.length()) return rows[r].retard; // utilise Retard comme numero train si rempli
      if (field == 'h' && rows[r].heure.length()) return rows[r].heure;
      if (field == 'd' && rows[r].destination.length()) return rows[r].destination;
      if (field == 'v' && rows[r].voie.length()) return rows[r].voie;
      if (field == 'i' && rows[r].info.length()) return rows[r].info;
    }
    if (field == 't') return String(data[r].logo);
    if (field == 'n') return String(data[r].numero);
    if (field == 'h') return String(data[r].heure);
    if (field == 'd') return String(data[r].destination);
    if (field == 'v') return String(data[r].voie);
    if (field == 'i') return String(data[r].via);
    return String("");
  };

  gfx->setTextWrap(false);
  gfx->setFont(NULL);

  // Fond fixe complet : uniquement au dessin complet, pas a chaque tick d'animation.
  if (!rowsOnlyPass) {
    gfx->fillRect(0, 0, 240, 135, pageBg);

    // Titre haut gauche petit, comme l'ecran reel.
    gfx->setTextSize(1);
    gfx->setTextColor(white, pageBg);
    gfx->setCursor(sx(4), sy(4));
    gfx->print("Arrivees");
  }

  // Geometrie du tableau.
  const int tableX = 2;
  const int tableY = 18;
  const int tableW = 236;
  const int firstH = 25;
  const int rowH   = 13;
  const int smallRows = 6;
  const int footerY = 122;
  const int tableH = firstH + smallRows * rowH;

  const int xLogo  = 4;
  const int xNum   = 31;
  const int xHour  = 66;
  const int xDest  = 100;
  const int xDestW = 96;
  const int xVoie  = 202;
  const int sideX  = 221;

  const uint32_t cycleMs = 3600UL;
  uint32_t now = millis();
  int base = (now / cycleMs) % count;
  static int renderedBase = -1;
  const uint32_t viaCycleMs = 7000UL;
  auto drawViaMarquee = [&](const String &rawVia, int y, uint16_t bg) {
    String via = rawVia;
    if (via.length() == 0) via = "Direct";
    String text = "  " + via + "     ";
    const int charW = 6;
    const int textX = xDest + 10;
    const int textW = xDestW - 10;
    const int maxChars = max(1, textW / charW);
    const int totalChars = max(maxChars + 1, (int)text.length());
    int offset = (int)(((now % viaCycleMs) * totalChars) / viaCycleMs);
    String doubled = text + text;
    if (offset >= (int)text.length()) offset %= text.length();
    String out = doubled.substring(offset, offset + maxChars);

    gfx->fillRect(sx(xDest), sy(y), xDestW, 10, bg);
    int dotX = textX - offset * charW;
    while (dotX < xDest - 3) dotX += text.length() * charW;
    while (dotX < xDest + xDestW) {
      if (dotX >= xDest && dotX <= xDest + xDestW - 4) gfx->fillCircle(sx(dotX), sy(y + 5), 2, yellow);
      dotX += text.length() * charW;
    }
    gfx->setTextSize(1);
    gfx->setTextColor(white, bg);
    gfx->setCursor(sx(textX), sy(y + 1));
    gfx->print(out);
  };

  // Tick leger : entre deux changements de train, on ne redessine que le via de la premiere ligne.
  if (rowsOnlyPass && renderedBase == base) {
    uint16_t bg0 = blueA;
    drawViaMarquee(rowText(base, 'i'), tableY + 14, bg0);
    return;
  }
  renderedBase = base;

  // Bandes fixes : redessinees seulement quand la page change ou au dessin complet.
  gfx->fillRect(tableX, tableY, tableW, tableH, blueB);
  gfx->fillRect(tableX, tableY, tableW, firstH - 1, blueA);
  for (int i = 0; i < smallRows; i++) {
    int y = tableY + firstH + i * rowH;
    gfx->fillRect(tableX, y, tableW, rowH - 1, (i & 1) ? blueA : blueB);
  }

  auto drawLogo = [&](const char *logo, int x, int y, uint16_t bg) {
    if (y < tableY - 10 || y > tableY + tableH) return;
    gfx->setTextSize(1);
    String lg = String(logo);
    if (lg == "SNCF") {
      gfx->fillRect(sx(x), sy(y), 22, 9, C_WHITE);
      gfx->setTextColor(0x03A0, C_WHITE);
      gfx->setCursor(sx(x + 1), sy(y + 1)); gfx->print("SNCF");
    } else if (lg == "TER") {
      // TER sans fond vert : texte blanc discret sur la ligne bleue.
      gfx->setTextColor(white, bg);
      gfx->setCursor(sx(x + 1), sy(y + 1)); gfx->print("ter");
    } else if (lg == "TGV") {
      gfx->setTextColor(white, bg);
      gfx->setCursor(sx(x + 1), sy(y + 1)); gfx->print("TGV");
    } else {
      gfx->fillRect(sx(x), sy(y), 18, 9, yellow);
      gfx->setTextColor(C_BLACK, yellow);
      gfx->setCursor(sx(x + 3), sy(y + 1)); gfx->print("IC");
    }
  };

  auto fitCell = [&](int x, int y, int w, int h, int wantedSize, uint16_t fg, uint16_t bg, const String &txt, bool scroll, int speed) {
    if (y + h < tableY || y > tableY + tableH) return;
    int yy = max(y, tableY);
    int hh = h - max(0, tableY - y);
    if (yy + hh > tableY + tableH) hh = tableY + tableH - yy;
    if (hh <= 0) return;
    int size = wantedSize;
    while (size > 1 && ((int)txt.length() * 6 * size) > (w - 2)) size--;
    int charW = max(1, 6 * size);
    int maxChars = max(1, (w - 2) / charW);
    String out = txt;
    if ((int)out.length() > maxChars) out = scroll ? marqueeSlice(out, maxChars, speed) : cutText(out, maxChars);
    gfx->fillRect(sx(x), sy(yy), w, hh, bg);
    gfx->setTextSize(size);
    gfx->setTextColor(fg, bg);
    gfx->setCursor(sx(x + 1), sy(y + max(0, (h - 8 * size) / 2)));
    gfx->print(out);
  };

  // Changement propre par ligne complete : pas de traces pendant la montee.
  int scrollPx = 0;

  auto drawActiveRow = [&](int rowIdx, int y0, uint16_t bg0) {
    drawLogo(rowText(rowIdx, 't').c_str(), xLogo, y0 + 4, bg0);
    fitCell(xNum,  y0 + 1, 32, 11, 1, white,  bg0, rowText(rowIdx, 'n'), false, 200);
    fitCell(xHour, y0 + 1, 32, 11, 1, yellow, bg0, rowText(rowIdx, 'h'), false, 200);
    // Destination modifiable depuis l'interface.
    fitCell(xDest, y0 + 1, xDestW, 11, 1, white, bg0, rowText(rowIdx, 'd'), false, 230);

    if (y0 + 14 >= tableY && y0 + 24 <= tableY + tableH) {
      drawViaMarquee(rowText(rowIdx, 'i'), y0 + 14, bg0);
    }

    // La voie ne s'affiche que pour la ligne du haut active.
    String voieTxt = rowText(rowIdx, 'v');
    if (voieTxt.length() && y0 >= tableY - 3 && y0 < tableY + firstH) {
      gfx->fillRoundRect(sx(xVoie), sy(y0 + 4), 15, 17, 2, blueB);
      gfx->drawRoundRect(sx(xVoie), sy(y0 + 4), 15, 17, 2, white);
      fitCell(xVoie + 2, y0 + 6, 11, 12, 2, white, blueB, voieTxt, false, 200);
    }
  };

  auto drawSmallRow = [&](int rowIdx, int line, int y) {
    uint16_t bg = (line & 1) ? blueA : blueB;
    drawLogo(rowText(rowIdx, 't').c_str(), xLogo, y + 3, bg);
    fitCell(xNum,  y + 2, 32, 10, 1, white,  bg, rowText(rowIdx, 'n'), false, 200);
    fitCell(xHour, y + 2, 32, 10, 1, yellow, bg, rowText(rowIdx, 'h'), false, 200);
    fitCell(xDest, y + 1, xDestW, 12, 1, white, bg, rowText(rowIdx, 'd'), false, 260 + line * 50);
  };

  // Redessine les infos en mouvement sur le fond fixe.
  drawActiveRow(base, tableY - scrollPx, blueA);
  for (int line = 0; line < smallRows + 1; line++) {
    int idx = (base + 1 + line) % count;
    int y = tableY + firstH + line * rowH - scrollPx;
    drawSmallRow(idx, line, y);
  }

  // Legendes basses fixes : uniquement au dessin complet.
  if (!rowsOnlyPass) {
    gfx->fillRect(0, footerY, 240, 13, pageBg);
    gfx->setTextSize(1);
    gfx->setTextColor(white, pageBg);
    gfx->setCursor(sx(4),   sy(124)); gfx->print("train");
    gfx->setCursor(sx(32),  sy(124)); gfx->print("no");
    gfx->setCursor(sx(67),  sy(124)); gfx->print("heure");
    gfx->setCursor(sx(101), sy(124)); gfx->print("provenance");
    gfx->setCursor(sx(207), sy(124)); gfx->print("voie");
    gfx->fillRect(sx(194), sy(122), 43, 12, 0x0012);
    gfx->drawRect(sx(194), sy(122), 43, 12, 0x0EAA);
    String clock = pm3dDynamicClock().substring(0, 5);
    clock.replace(':', ' ');
    gfx->setCursor(sx(199), sy(125)); gfx->print(clock);
  }

  // Mot "arrivees" dessine EN DERNIER : il passe au-dessus des lignes et n'est plus cache.
  auto patFor = [](char c)->const char* const* {
    static const char* d[] = {"00000","11110","10001","10001","10001","10001","11110"};
    static const char* e[] = {"00000","01110","10001","11111","10000","10001","01110"};
    static const char* p[] = {"00000","11110","10001","10001","11110","10000","10000"};
    static const char* a[] = {"00000","01110","00001","01111","10001","10011","01101"};
    static const char* r[] = {"00000","10110","11001","10000","10000","10000","10000"};
    static const char* i[] = {"00100","00000","01100","00100","00100","00100","01110"};
    static const char* v[] = {"00000","10001","10001","10001","10001","01010","00100"};
    static const char* t[] = {"00100","00100","11111","00100","00100","00101","00010"};
    static const char* s[] = {"00000","01111","10000","01110","00001","10001","01110"};
    switch (c) { case 'd': return d; case 'e': return e; case 'p': return p; case 'a': return a; case 'r': return r; case 'i': return i; case 'v': return v; case 's': return s; default: return t; }
  };
  auto drawRotChar = [&](char c, int x, int y, int sc, uint16_t col) {
    const char* const* p = patFor(c);
    for (int yy = 0; yy < 7; yy++) {
      for (int xx = 0; xx < 5; xx++) {
        if (p[yy][xx] == '1') {
          gfx->fillRect(sx(x + yy * sc), sy(y + (4 - xx) * sc), sc, sc, col);
        }
      }
    }
  };

  const char *sideWord = "arrivees";  // affichage visuel : arrivees + accent sur le premier e
  const int sideScale = 2;
  const int sideStep = 11;
  int sideY = 108 + styleSideY;     // arrivees a 8 lettres : pas resserre pour rester cale, reglable par style.
  for (int i = 0; sideWord[i]; i++) drawRotChar(sideWord[i], sideX, sideY - i * sideStep, sideScale, sideTxt);
  // Accent du premier e de arrivees.
  int eY = sideY - 5 * sideStep;
  gfx->drawLine(sx(sideX + 3), sy(eY - 5), sx(sideX + 9), sy(eY - 9), sideTxt);
  gfx->drawLine(sx(sideX + 4), sy(eY - 5), sx(sideX + 10), sy(eY - 9), sideTxt);
}


