  if (server.hasArg("sdDest")) sncfDetailDestScale = server.arg("sdDest").toInt();
  if (server.hasArg("trInfoText")) {
    transilienInfoText = server.arg("trInfoText");
    transilienInfoText.trim();
    if (transilienInfoText.length() > 220) transilienInfoText = transilienInfoText.substring(0, 220);
  }
  if (server.hasArg("retroSt")) retroStationName = server.arg("retroSt");
  if (displayProfile == "fr_sncf_valence_side") {
    userRowsEdited = true;
    for (int i = 0; i < MAX_ROWS; i++) {
      if (server.hasArg("h" + String(i))) rows[i].heure = server.arg("h" + String(i));
      if (server.hasArg("r" + String(i))) rows[i].retard = server.arg("r" + String(i));
