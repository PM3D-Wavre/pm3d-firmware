String safeBackTarget(const String &rawBack) {
  String back = rawBack.length() ? rawBack : String("/main");
  if (!back.startsWith("/")) back = "/main";
  if (back.startsWith("//")) back = "/main";
  if (back.indexOf("://") >= 0) back = "/main";
  return back;
}

