      if (server.hasArg("v" + String(i))) rows[i].voie = server.arg("v" + String(i));
    }
  }
  normalizeSettings();
  bool globalStyleSaved = server.hasArg("swissMsg") || server.hasArg("trInfoText") || server.hasArg("luxMsg") || displayStyleSaved;
  if (server.hasArg("swissMsg")) {
    swissInfoMessage = server.arg("swissMsg");
    swissInfoMessage.trim();
    if (swissInfoMessage.length() > 140) swissInfoMessage = swissInfoMessage.substring(0, 140);
  }
  if (server.hasArg("trInfoText")) {
    transilienInfoText = server.arg("trInfoText");
    transilienInfoText.trim();
    if (transilienInfoText.length() > 220) transilienInfoText = transilienInfoText.substring(0, 220);
  }
  if (server.hasArg("retroSt")) retroStationName = server.arg("retroSt");
  if (server.hasArg("luxMsg")) {
    luxembourgInfoMessage = server.arg("luxMsg");
    luxembourgInfoMessage.trim();
    if (luxembourgInfoMessage.length() > 180) luxembourgInfoMessage = luxembourgInfoMessage.substring(0, 180);
  }
  saveStyleTune(profile);
  if (globalStyleSaved) saveConfig();
  if (displayStyleSaved) analogWrite(TFT_BL, screenBrightness);
  if (profile == displayProfile) fullRedrawNeeded = true;
  else loadStyleTune(displayProfile);
  server.sendHeader("Location", "/country?c=" + back);
  server.send(303);
}

void handleSaveAdvanced() {
  bool apPasswordChanged = false;
  if (server.hasArg("apPass")) {
    String nextPass = server.arg("apPass");
