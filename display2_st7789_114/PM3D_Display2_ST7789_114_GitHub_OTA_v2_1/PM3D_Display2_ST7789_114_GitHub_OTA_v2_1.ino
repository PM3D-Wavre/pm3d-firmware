int visibleRowIndex(int pos) {
  int total = filledRowCount();
  if (total <= 0) return pos % MAX_ROWS;
  int wanted = pos % total;
  for (int i = 0; i < MAX_ROWS; i++) {
    if (!rowIsFilled(i)) continue;
    if (wanted == 0) return i;
    wanted--;
  }
  return 0;
}

