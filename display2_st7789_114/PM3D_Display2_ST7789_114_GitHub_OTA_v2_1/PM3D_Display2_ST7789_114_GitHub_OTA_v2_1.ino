void drawScaledGfxText(int x, int y, uint16_t color, const GFXfont *font, const String &txt, int scalePct) {
  if (!font) return;
  // Reglage SNCF detail en vrai 0..100 : 0 = masque, 70 = taille par defaut.
  if (scalePct <= 0) return;
  scalePct = constrain(scalePct, 1, 100);
  uint8_t first = pgm_read_byte(&font->first);
  uint8_t last = pgm_read_byte(&font->last);
  int16_t cursorX = 0;
  int dotSize = (scalePct > 115) ? 2 : 1;
  for (uint16_t n = 0; n < txt.length(); n++) {
    char c = txt[n];
    if (c < first || c > last) {
      cursorX += 6;
      continue;
    }
    GFXglyph *glyph = &(((GFXglyph *)pgm_read_pointer(&font->glyph))[c - first]);
    uint8_t *bitmap = (uint8_t *)pgm_read_pointer(&font->bitmap);
    uint16_t bo = pgm_read_word(&glyph->bitmapOffset);
    uint8_t w = pgm_read_byte(&glyph->width);
    uint8_t h = pgm_read_byte(&glyph->height);
    uint8_t xa = pgm_read_byte(&glyph->xAdvance);
    int8_t xo = (int8_t)pgm_read_byte(&glyph->xOffset);
    int8_t yo = (int8_t)pgm_read_byte(&glyph->yOffset);
    uint16_t bit = 0;
    for (uint8_t yy = 0; yy < h; yy++) {
      for (uint8_t xx = 0; xx < w; xx++, bit++) {
        uint8_t bits = pgm_read_byte(&bitmap[bo + (bit >> 3)]);
        if (bits & (0x80 >> (bit & 7))) {
          int px = x + ((cursorX + xo + xx) * scalePct) / 100;
          int py = y + ((yo + yy) * scalePct) / 100;
          if (dotSize == 1) gfx->drawPixel(sx(px), sy(py), color);
          else gfx->fillRect(sx(px), sy(py), dotSize, dotSize, color);
        }
      }
    }
    cursorX += xa;
  }
}

void drawSncfValenceSideRows() {
  // SNCF train detail / ecran de quai : style photo fournie.
  // Gauche : fiche blanche personnalisable. Droite : liste via blanche sur bleu.
  const uint16_t blue      = 0x02B8;   // bleu SNCF detail cote droit
  const uint16_t blueDark  = 0x0155;   // rectangle heure actuelle
  const uint16_t blueBar   = 0x033D;   // barre verticale un peu differente
  const uint16_t paper     = 0xF7BF;   // blanc legerement casse
  const uint16_t ink       = blue;     // texte fiche en bleu identique au cote droit
  const uint16_t inkLight  = 0x3B5F;   // bleu/gris plus clair
  const uint16_t fade      = 0xD69A;   // gris clair, un peu plus visible sur le blanc
  const uint16_t dot       = 0xFFE0;   // pastilles jaunes
  const uint16_t orangeSec = 0xFD20;   // secondes orange
  const uint16_t sncfBg    = 0xB01A;   // magenta/violet logo SNCF photo

  Row &mainRow = rows[visibleRowIndex(scrollOffset)];
