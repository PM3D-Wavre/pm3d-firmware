bool parseDisplayTime(const String &raw, int &minutes, char &sep) {
  if (raw.length() < 4) return false;
  int pos = raw.indexOf(':');
  sep = ':';
  if (pos < 0) {
    pos = raw.indexOf('h');
    sep = 'h';
  }
  if (pos < 1 || pos + 2 >= raw.length()) return false;
  int hh = raw.substring(max(0, pos - 2), pos).toInt();
  int mm = raw.substring(pos + 1, pos + 3).toInt();
  if (hh < 0 || hh > 23 || mm < 0 || mm > 59) return false;
  minutes = hh * 60 + mm;
  return true;
}

String formatDisplayTime(int minutes, char sep) {
  minutes = (minutes % 1440 + 1440) % 1440;
  char buf[6];
  snprintf(buf, sizeof(buf), "%02d%c%02d", minutes / 60, sep == 'h' ? 'h' : ':', minutes % 60);
  return String(buf);
}

void resetDynamicTimeBase() {
  dynamicTimeBaseReady = false;
  dynamicTimeProfile = "";
  lastSyncedMinute = -1;
}

void captureDynamicTimeBase() {
  int firstMinutes = -1;
  char firstSep = ':';
  for (int i = 0; i < MAX_ROWS; i++) {
    int m = 0;
    char sep = ':';
    if (rowIsFilled(i) && parseDisplayTime(rows[i].heure, m, sep)) {
      firstMinutes = m;
      firstSep = sep;
      break;
    }
  }
  if (firstMinutes < 0) return;
  for (int i = 0; i < MAX_ROWS; i++) {
    int m = 0;
    char sep = firstSep;
    if (rowIsFilled(i) && parseDisplayTime(rows[i].heure, m, sep)) {
      dynamicTimeBase[i] = (m - firstMinutes + 1440) % 1440;
      dynamicTimeSep[i] = sep;
    } else {
      dynamicTimeBase[i] = -1;
      dynamicTimeSep[i] = firstSep;
    }
  }
  dynamicTimeProfile = displayProfile;
  dynamicTimeBaseReady = true;
}

bool browserClockMinutes(int &minutes) {
  if (!browserTimeValid) return false;
  unsigned long elapsed = (millis() - browserTimeBaseMillis) / 1000UL;
  unsigned long total = ((unsigned long)browserTimeBaseSeconds + elapsed) % 86400UL;
  minutes = total / 60UL;
  return true;
}

bool syncedClockMinutes(int &minutes) {
  if (browserClockMinutes(minutes)) return true;
  if (WiFi.status() != WL_CONNECTED) return false;
  if (!ntpStarted) {
    configTzTime("CET-1CEST,M3.5.0/2,M10.5.0/3", "pool.ntp.org", "time.google.com", "time.cloudflare.com");
    ntpStarted = true;
  }
  struct tm ti;
  if (!getLocalTime(&ti, 80)) return false;
  minutes = ti.tm_hour * 60 + ti.tm_min;
  return true;
}

bool alignRowsToCurrentTime(int currentMinutes) {
  int firstMinutes = -1;
  for (int i = 0; i < MAX_ROWS; i++) {
    char sep = ':';
    if (rowIsFilled(i) && parseDisplayTime(rows[i].heure, firstMinutes, sep)) break;
  }
  if (firstMinutes < 0) return false;

  int hourShift = ((currentMinutes / 60) - (firstMinutes / 60) + 24) % 24;
  if (hourShift == 0) return false;

  bool changed = false;
  for (int i = 0; i < MAX_ROWS; i++) {
    int minutes = 0;
    char sep = ':';
    if (!rowIsFilled(i) || !parseDisplayTime(rows[i].heure, minutes, sep)) continue;
    String aligned = formatDisplayTime(minutes + hourShift * 60, sep);
    if (rows[i].heure != aligned) {
      rows[i].heure = aligned;
      changed = true;
    }
  }
  return changed;
}

void updateRowsFromSyncedClock(unsigned long now) {
  if (now - lastTimeSyncCheck < 5000UL) return;
  lastTimeSyncCheck = now;
  int currentMinutes = 0;
  if (!syncedClockMinutes(currentMinutes)) return;
  if (currentMinutes == lastSyncedMinute && now - lastTimeRowsRefresh < 30000UL) return;
  lastSyncedMinute = currentMinutes;
  lastTimeRowsRefresh = now;
  if (autoAlignTrainTimes) {
    if (alignRowsToCurrentTime(currentMinutes)) {
      resetDynamicTimeBase();
      fullRedrawNeeded = true;
    }
    return;
  }
  if (!dynamicTimeBaseReady || dynamicTimeProfile != displayProfile) captureDynamicTimeBase();
  if (!dynamicTimeBaseReady) return;
  for (int i = 0; i < MAX_ROWS; i++) {
    if (dynamicTimeBase[i] >= 0) rows[i].heure = formatDisplayTime(currentMinutes + dynamicTimeBase[i], dynamicTimeSep[i]);
  }
  fullRedrawNeeded = true;
}
