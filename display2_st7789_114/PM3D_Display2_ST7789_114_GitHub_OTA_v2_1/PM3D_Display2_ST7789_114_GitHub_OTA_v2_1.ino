void drawLuxembourgCflRows() {
  const uint16_t bg = 0x03BF;
  const uint16_t header = 0x04BF;
  const uint16_t rowA = 0x037F;
  const uint16_t rowB = 0x0277;
  const uint16_t dark = 0x0150;
  const uint16_t yellow = 0xFEA0;
  const uint16_t warn = 0xFCE0;
  const uint16_t line = 0x2D9F;
  gfx->fillRect(3, 3, 234, 129, bg);
  gfx->fillRect(4, 4, 232, 18, header);
  fixedSmallText(8, 9, C_WHITE, rows[0].heure.length() ? rows[0].heure : "15:33:15");
  fixedSmallText(82, 9, C_WHITE, "Depart / Abfahrt");
  fixedSmallText(210, 9, C_WHITE, "CFL");

  int visible = constrain(nbVisible, 1, 6);
  int top = 24;
  int bottom = 114;
  int rowH = max(10, (bottom - top) / visible);
  for (int i = 0; i < visible; i++) {
    int idx = visibleRowIndex(scrollOffset + i);
    int y = top + i * rowH;
    uint16_t fill = (i % 2) ? rowB : rowA;
    gfx->fillRect(4, y, 232, rowH - 1, fill);
    gfx->drawFastHLine(4, y + rowH - 1, 232, line);
    String info = rows[idx].info;
    String train = rows[idx].typeTrain.length() ? rows[idx].typeTrain : "RE";
    bool cancelled = info.indexOf("Sup") >= 0 || info.indexOf("sup") >= 0;
    bool delayed = info.indexOf("Retard") >= 0 || info.startsWith("+") || rows[idx].retard.startsWith("+");
    String status = "";
    if (cancelled) status = "Suppr.";
    else if (delayed) status = rows[idx].retard.startsWith("+") ? cutText(rows[idx].retard, 4) : "Ret.";
    fixedSmallText(7, y + 2, delayed || cancelled ? yellow : C_WHITE, cutText(rows[idx].heure, 5));
    if (status.length()) fixedSmallText(42, y + 2, yellow, status);
    fixedSmallText(76, y + 2, C_WHITE, cutText(rows[idx].destination, 11));
    String detail = info;
    if (detail == status || detail.indexOf("Retard") >= 0 || detail.indexOf("Sup") >= 0 || detail.startsWith("+")) detail = rows[idx].retard;
    if (detail.startsWith("+") || detail.length() < 4) detail = "";
    if (detail.length()) fixedSmallText(145, y + 2, 0xD6FF, cutText(detail, 8));
    fixedSmallText(198, y + 2, C_WHITE, cutText(train, 3));
    fixedSmallText(225, y + 2, C_WHITE, cutText(rows[idx].voie, 2));
  }

  String msg = luxembourgInfoMessage;
  msg.trim();
  if (!msg.length()) msg = "Info perturbations : Des retards et suppressions a prevoir entre Luxembourg et Bettembourg.";
  gfx->fillRect(4, 116, 232, 15, warn);
  fixedSmallText(7, 120, dark, marqueeSlice(msg, 38, 240)); // defilement droite -> gauche
}

