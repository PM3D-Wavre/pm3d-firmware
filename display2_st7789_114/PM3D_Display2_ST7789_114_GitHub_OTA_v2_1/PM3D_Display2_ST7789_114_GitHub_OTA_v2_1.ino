void loop() {
  dnsServer.processNextRequest();
  server.handleClient();

  unsigned long now = millis();

  updateRowsFromSyncedClock(now);

  if (demoMode) {
    updateDemoMode(now);
    if (demoShowingFlag) {
      delay(10);
      yield();
      return;
    }
  }

  if (fullRedrawNeeded) {
    fullRedrawNeeded = false;
    drawScreenFull();
  }

  if ((screenMode == 2 || isRetroProfile()) && retroAnimating && now - lastRetro >= RETRO_DELAY) {
    lastRetro = now;
    retroAnimateOneStep();
  }


  if (displayProfile == "it_fs_photo" && now - lastDbClock >= 120UL) {
    lastDbClock = now;
    drawItalyFsPhotoBanner();
  }
  if (displayProfile == "de_db_intercity" && now - lastDbClock >= 75UL) {
    lastDbClock = now;
    drawDbIntercityMarquee(0x2817, 0x8CB2);
  }

  if (displayProfile == "de_db_large_blue" && now - lastDbClock >= 1000UL) {
    lastDbClock = now;
    drawDbClockBox();
    drawDbUberCells();
  }

  if (displayProfile == "de_baden_baden" && now - lastDbClock >= 1000UL) {
    lastDbClock = now;
    drawBadenBadenHeader();
  }

  if ((displayProfile == "ch_sbb_blue" || displayProfile == "ch_sbb_romandie") && now - lastDbClock >= 60UL) {
    lastDbClock = now;
    drawSwissInfoBanner();
  }

  if ((displayProfile == "pt_ip_departures" || displayProfile == "pt_ip_arrivals") && now - lastDbClock >= 90UL) {
    lastDbClock = now;
    drawPortugalMessageBand(displayProfile == "pt_ip_arrivals");
  }

  if (displayProfile == "lu_cfl_departures" && now - lastDbClock >= 120UL) {
    lastDbClock = now;
    drawLuxembourgCflBanner();
  }

  if (displayProfile == "nl_ns_light" && now - lastDbClock >= 120UL) {
    lastDbClock = now;
    drawNsLightInfoBand();
  }

  // SNCF detail : l'horloge et le bandeau bas restent fluides en permanence.
  // Les via (partie droite) ne sont recalcules que toutes les 2 secondes pour eviter les accoups.
  if (displayProfile == "fr_sncf_valence_side") {
    static unsigned long lastSncfViaRefresh = 0;
    int sncfViaFilled = 0;
    for (int idx = 1; idx < MAX_ROWS; idx++) {
      String vtxt = rows[idx].destination;
      vtxt.trim();
      if (vtxt.length()) sncfViaFilled++;
    }
    if (now - lastDbClock >= 80UL) {
      lastDbClock = now;
      drawSncfValenceSideDynamicOnly(); // secondes + bandeau bas en temps reel
    }
    if (sncfViaFilled > 8 && now - lastSncfViaRefresh >= 2000UL) {
      lastSncfViaRefresh = now;
      drawSncfValenceSideRows(); // via bas -> haut toutes les 2 secondes
    }
  }

  if (displayProfile == "fr_sncf_2009_led" && now - lastDbClock >= 120UL) {
    lastDbClock = now;
    drawSncf2009InfoBand();
  }

  if (displayProfile == "fr_montparnasse_2010" && now - lastDbClock >= 120UL) {
    lastDbClock = now;
    drawMontparnasse2010InfoBand();
  }


  if ((displayProfile == "fr_sncf_depart_grandes_lignes" || displayProfile == "fr_sncf_arrivees_grandes_lignes") && now - lastDbClock >= 220UL) {
    lastDbClock = now;
    drawRowsOnly();
  }

  if (displayProfile == "de_db_2010_2015" && now - lastDbClock >= 360UL) {
    lastDbClock = now;
    drawRowsOnly();
  }

  if (displayProfile == "fr_sncf_1990_flipflap" && now - lastRetro >= 80UL && now - lastScroll < 1250UL) {
    lastRetro = now;
    bool savedRowsOnly = rowsOnlyPass;
    rowsOnlyPass = true;
    drawSncf1990FlipFlapRows();
    rowsOnlyPass = savedRowsOnly;
  }

  if ((displayProfile == "be_sncb_detail" || displayProfile == "fr_sncf_new") && now - lastRetro >= 80UL) {
    lastRetro = now;
    if (now - lastScroll < 1200UL) drawRowsOnly();
  }

  int scrollableRows = filledRowCount();
  if (displayProfile == "fr_sncf_valence_side") {
    scrollableRows = 1;
    scrollOffset = 0;
  }
  int visibleRows = max(1, scrollWindowRows());
  if (scrollableRows <= visibleRows && scrollOffset != 0) {
    scrollOffset = 0;
    if (!retroAnimating) drawScreenFull();
  }
  unsigned long activeScrollDelay = (displayProfile == "fr_sncf_1990_flipflap" || displayProfile == "be_sncb_detail" || displayProfile == "fr_sncf_new") ? 5000UL : (unsigned long)scrollDelayMs;
  if (scrollableRows > visibleRows && !retroAnimating && displayProfile == "fr_sncf_1990_flipflap" && now - lastScroll >= activeScrollDelay) {
    lastScroll = now;
    scrollOffset = (scrollOffset + 1) % scrollableRows;
    drawSncf1990FlipFlapRows();
  } else if (scrollableRows > visibleRows && !retroAnimating && isRetroProfile() && now - lastScroll >= activeScrollDelay) {
    lastScroll = now;
    scrollOffset = (scrollOffset + 1) % scrollableRows;
    resetRetroDisplay();
  } else if (scrollableRows > visibleRows && !retroAnimating && now - lastScroll >= activeScrollDelay) {
    lastScroll = now;
    scrollOffset = (scrollOffset + 1) % scrollableRows;
    drawRowsOnly();
  }
}










