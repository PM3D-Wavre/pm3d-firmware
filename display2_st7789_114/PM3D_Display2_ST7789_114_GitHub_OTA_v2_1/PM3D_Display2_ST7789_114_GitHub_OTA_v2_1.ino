int scrollWindowRows() {
  if (displayProfile == "de_db_intercity") return min(nbVisible, 3);
  if (displayProfile == "fr_sncf_valence_side") return min(nbVisible, 8);
  // IP/CP Portugal : l'affichage montre 6 lignes.
  // Departs : on force la fenetre de defilement a 5 pour que le profil bleu defile
  // meme quand seulement 6 lignes sont remplies/personnalisees.
  if (displayProfile == "pt_ip_departures") return min(nbVisible, 5);
  if (displayProfile == "pt_ip_arrivals") return min(nbVisible, 6);
  return nbVisible;
}

