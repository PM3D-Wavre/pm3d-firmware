void applyProfileToScreenMode() {
  if (displayProfile == "fr_splitflap" || displayProfile == "ch_sbb_splitflap") screenMode = 2;
  else if (displayProfile == "fr_sncf_depart_grandes_lignes" || displayProfile == "fr_sncf_arrivees_grandes_lignes") screenMode = 4;
  else if (displayProfile == "fr_sncf_white") screenMode = 3;
  else if (displayProfile == "fr_sncf_new" || displayProfile == "be_sncb_detail_list" || displayProfile == "be_sncb_2023_photo" || displayProfile == "be_sncb_modern" || displayProfile == "be_sncb_grid" || displayProfile == "be_sncb_detail") screenMode = 0;
  else if (displayProfile == "de_db_large_blue" || displayProfile == "de_db_intercity" || displayProfile == "de_db_2010_2015" || displayProfile == "de_db_2022") screenMode = 4;
  else if (displayProfile.startsWith("it_")) screenMode = 3;
  else if (displayProfile.startsWith("hu_")) screenMode = 3;
  else screenMode = 3;
  normalizeSettings();
}

