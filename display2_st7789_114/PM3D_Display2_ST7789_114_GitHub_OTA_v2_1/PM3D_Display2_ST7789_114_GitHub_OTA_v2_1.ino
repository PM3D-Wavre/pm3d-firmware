char flapRandomChar(int visibleRow, int charPos) {
  const char table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 -";
  int n = sizeof(table) - 1;
  return table[(millis() / 70 + visibleRow * 11 + charPos * 5) % n];
}

