void drawPortugalInfraRows(bool arrivals) {
  // Profil IP/CP Portugal.
  // Arrivees : on ne retouche pas au theme vert valide.
  // Departs : theme bleu IP/CP. La barre HORA/ORIGEM reste turquoise.
  const uint16_t bg       = arrivals ? 0x0108 : 0x0010;  // arrivees vert tres fonce / departs bleu tres fonce
  const uint16_t titleBar = arrivals ? 0x04E0 : 0x001F;  // titre haut : vert en arrivees, bleu en departs
  const uint16_t rowA     = arrivals ? 0x05E0 : 0x02BF;  // arrivees vert / departs bleu
  const uint16_t rowB     = arrivals ? 0x02E6 : 0x0158;  // arrivees vert-gris / departs bleu fonce
  const uint16_t head     = 0x471A; // #40E0D0 turquoise  // barre HORA/ORIGEM/LM/COMBOIO/OBS uniquement
  const uint16_t band     = 0x03EE;
  const uint16_t line     = arrivals ? 0x0F29 : 0x05FF;

  gfx->fillRect(0, 0, 240, 135, bg);
  gfx->fillRect(0, 0, 240, 23, titleBar);
  drawPortugalIpLogo(5, 3, titleBar);
  fixedSmallText(arrivals ? 72 : 66, 9, C_WHITE, arrivals ? "CHEGADAS / ARRIVALS" : "PARTIDAS / DEPARTURES");

  gfx->fillRect(3, 24, 234, 13, head);
  gfx->drawFastHLine(3, 37, 234, C_WHITE);
  fixedSmallText(7, 28, C_WHITE, "HORA");
  fixedSmallText(52, 28, C_WHITE, arrivals ? "ORIGEM" : "DESTINO");
  fixedSmallText(132, 28, C_WHITE, "LM");
  fixedSmallText(157, 28, C_WHITE, "COMBOIO");
  fixedSmallText(211, 28, C_WHITE, "OBS");

  // Arrivees : garde les 6 lignes vertes validees.
  // Departs : seulement 5 lignes visibles pour que le profil bleu defile vraiment.
  int visible = arrivals ? min(6, max(1, nbVisible)) : min(5, max(1, nbVisible));
  int top = 38;
  int rowH = 13;
  for (int i = 0; i < visible; i++) {
    int idx = visibleRowIndex(scrollOffset + i);
    int y = top + i * rowH;
    gfx->fillRect(3, y, 234, rowH - 1, (i % 2) ? rowB : rowA);
    gfx->drawFastHLine(3, y + rowH - 1, 234, line);
    fixedSmallText(7, y + 3, C_WHITE, cutText(rows[idx].heure, 5));
    fixedSmallText(52, y + 3, C_WHITE, cutText(rows[idx].destination, 15));
    fixedSmallText(133, y + 3, C_WHITE, cutText(rows[idx].voie, 2));
    String train = rows[idx].typeTrain.length() ? rows[idx].typeTrain : "SUBU";
    String num = rows[idx].info.length() ? rows[idx].info : rows[idx].retard;
    fixedSmallText(156, y + 3, C_WHITE, cutText(train, 5));
    fixedSmallText(183, y + 3, C_WHITE, cutText(num, 5));
    // Colonne OBS : plus aucun symbole/logo, uniquement du texte si necessaire.
    String obs = rows[idx].retard;
    if (obs == num) obs = "";
    if (obs.length()) fixedSmallText(211, y + 3, C_WHITE, cutText(obs, 4));
  }

  drawPortugalMessageBand(arrivals);
}

void drawPortugalMessageBand(bool arrivals) {
  const uint16_t band = 0x0451;  // bleu bouteille turquoise
  gfx->fillRect(0, 119, 240, 16, band);
  gfx->drawFastHLine(0, 119, 240, C_WHITE);
  gfx->drawCircle(9, 127, 5, C_WHITE);
  fixedSmallText(8, 124, C_WHITE, "i");
  String msg = transilienInfoText;
  msg.trim();
  bool foreignMsg = msg.indexOf("Minder treinen") >= 0 || msg.indexOf("Schiphol") >= 0 || msg.indexOf("Transilien") >= 0 || msg.indexOf("Travaux") >= 0;
  if (!msg.length() || foreignMsg) msg = rows[0].retard;
  if (!msg.length() || msg.length() < 10 || msg == rows[0].info) msg = arrivals ? "Informacao : consulte os horarios de chegada antes da viagem." : "Informacao : consulte os horarios de partida antes da viagem.";

  if (arrivals) {
    // Arrivees : conserve le comportement valide.
    fixedSmallText(20, 124, C_WHITE, marqueeSlice(msg, 36, 220));
  } else {
    // Portugal depart uniquement : defilement force de droite vers gauche,
    // meme si le message est plus court que la largeur visible.
    String scrollMsg = msg + "        " + msg + "        ";
    fixedSmallText(20, 124, C_WHITE, marqueeWindow(scrollMsg, 36, 150));
  }
}
