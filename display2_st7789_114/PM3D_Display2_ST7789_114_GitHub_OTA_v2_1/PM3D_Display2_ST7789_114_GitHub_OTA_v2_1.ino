void normalizeSncfDetailMessage() {
  transilienInfoText.trim();
  if (transilienInfoText == "En raison des conditions climatiques, certains trains son supprimes" || transilienInfoText == "En raison des conditions climatiques, certains trains sont supprimés" || transilienInfoText == "En raison des conditions climatiques, certains trains sont supprim\xC3\xA9s") {
    transilienInfoText = "En raison des conditions climatiques, certains trains sont supprimes";
  }
}

void ensureSncfValenceSideDefaults() {
  if (displayProfile != "fr_sncf_valence_side") return;
  normalizeSncfDetailMessage();
  if (!rows[0].heure.length()) rows[0].heure = "12h43";
  if (!rows[0].info.length()) rows[0].info = "\xC3\xA0 l'heure";
  if (!rows[0].destination.length()) rows[0].destination = "Valence";
  if (!rows[0].typeTrain.length()) rows[0].typeTrain = "TER 17524";
  const char *sncfViaKeep[11] = {"Montmelian", "Pontcharra sur Breda", "Grenoble Univ. - Gieres", "Grenoble", "Moirans", "Tullins Fures", "Saint-Marcellin", "St-Hilaire - St-Nazaire", "Romans - Bourg-de-Peage", "Valence TGV Rhone-Alpes", "Valence Ville"};
  for (int v = 1; v <= 11 && v < MAX_ROWS; v++) {
    rows[v].destination.trim();
    if (!rows[v].destination.length()) rows[v].destination = String(sncfViaKeep[v - 1]);
  }
}

void normalizeSettings() {
  if (!styleTitle(displayProfile).length()) displayProfile = "fr_sncf_new";
  int maxRows = profileMaxVisibleRows(displayProfile);
  if (nbVisible < 1) nbVisible = 1;
  if (nbVisible > maxRows) nbVisible = maxRows;
  if (scrollDelayMs < 500) scrollDelayMs = 500;
  if (scrollDelayMs > 15000) scrollDelayMs = 15000;
  if (screenBrightness < 20) screenBrightness = 20;
  if (screenBrightness > 255) screenBrightness = 255;
  if (displayFontSize < 1) displayFontSize = 1;
  if (displayFontSize > 12) displayFontSize = 12;
  sncfDetailTimeScale = constrain(sncfDetailTimeScale, 0, 100);
  sncfDetailDestScale = constrain(sncfDetailDestScale, 0, 100);
  badenSteig.trim();
  if (badenSteig.length() == 0) badenSteig = "1a";
  if (badenSteig.length() > 6) badenSteig = badenSteig.substring(0, 6);
  dbIntercityMessage.trim();
  if (dbIntercityMessage.length() == 0) dbIntercityMessage = "Bitte beachten Sie die Anzeige am Bahnsteig";
  if (dbIntercityMessage.length() > 96) dbIntercityMessage = dbIntercityMessage.substring(0, 96);
  swissInfoMessage.trim();
  if (swissInfoMessage.length() == 0) swissInfoMessage = "Horaire modifie. Consultez l'affichage en gare avant votre voyage.";
  if (swissInfoMessage.length() > 140) swissInfoMessage = swissInfoMessage.substring(0, 140);
  if (swissBannerSpeed > 10) swissBannerSpeed = 5;
  swissBannerSpeed = constrain(swissBannerSpeed, 1, 10);
  japanTextMode = 0;
  japanAlternateSeconds = constrain(japanAlternateSeconds, 2, 60);
  dbIntercityClockHour = constrain(dbIntercityClockHour, 0, 23);
  dbIntercityClockMinute = constrain(dbIntercityClockMinute, 0, 59);
  db2010Title.trim();
  if (db2010Title.length() == 0) db2010Title = "Abfahrt Bochum Hbf";
  if (db2010Title.length() > 36) db2010Title = db2010Title.substring(0, 36);
  db2010TitleFontSize = constrain(db2010TitleFontSize, 1, 3);
  if (screenMode < 0 || screenMode > 4) screenMode = 0;
  countryButtonFont = constrain(countryButtonFont, 0, 13);
  countryButtonFontSize = constrain(countryButtonFontSize, 0, 10);
  retroStationName.trim();
  if (retroStationName.length() == 0) retroStationName = "Paris-Est";
  if (retroStationName.length() > 28) retroStationName = retroStationName.substring(0, 28);
  ensureSncfValenceSideDefaults();
}

