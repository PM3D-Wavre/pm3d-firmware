  if (server.hasArg("syv")) styleSideY = constrain(server.arg("syv").toInt(), -40, 40);
  bool displayStyleSaved = server.hasArg("nb") || server.hasArg("font") || server.hasArg("scrollMs") || server.hasArg("bright") || server.hasArg("sdTime") || server.hasArg("sdDest");
  if (server.hasArg("nb")) nbVisible = constrain(server.arg("nb").toInt(), 1, profileMaxVisibleRows(displayProfile));
  if (server.hasArg("font")) displayFontSize = parseFontLevel(server.arg("font"));
